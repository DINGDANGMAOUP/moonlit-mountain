{
  "name": "moonlit-mountain",
  "version": "0.0.2",
  "private": true,
  "description": "山月记：支持深夜、暮色、月白与跟随系统“月相”配色的 Halo 内容主题，默认保持当前深夜品牌",
  "author": "dingdangmaoup",
  "repository": {
    "type": "git",
    "url": "https://github.com/DINGDANGMAOUP/moonlit-mountain.git"
  },
  "homepage": "https://github.com/DINGDANGMAOUP/moonlit-mountain",
  "bugs": {
    "url": "https://github.com/DINGDANGMAOUP/moonlit-mountain/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "check:i18n": "node scripts/check-i18n.mjs",
    "build": "node scripts/check-i18n.mjs && vite build && theme-package",
    "build-only": "node scripts/check-i18n.mjs && vite build"
  },
  "devDependencies": {
    "@halo-dev/theme-package-cli": "^1.0.1",
    "@halo-dev/vite-plugin-halo-theme": "1.0.3",
    "vite": "^8.1.6"
  },
  "packageManager": "pnpm@10.33.0"
}
